# ==============================================
# NutriFit AI — шаблон переменных окружения
# Скопируй в .env и заполни реальными значениями
# ==============================================

# Database
DB_PASSWORD=your_db_password_here

# JWT — минимум 32 символа, случайная строка
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# OpenAI — получить на platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# CORS — список разрешённых frontend origins (через запятую)
# Пример: http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000

# pgAdmin (только для docker-compose)
PGADMIN_PASSWORD=your_pgadmin_password
